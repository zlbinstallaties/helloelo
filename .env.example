# Dashboard (src/): reads Odoo only through the DIG Odoo gateway. Server secrets only.
DIG_GATEWAY_URL=
DIG_GATEWAY_TOKEN=
# Optional: base URL used for links to Odoo forms.
ODOO_PUBLIC_URL=

# DIG Builder (independent build service; all values are intentionally empty)
BUILDER_ADMIN_TOKEN=
BUILDER_DATA_DIR=/data
BUILDER_RUNNER_URL=http://runner:8090
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PROPOSAL_MAX_OUTPUT_TOKENS=2048

# Odoo gateway (gateway/): the only place that holds the Odoo key (JSON-2 API,
# Odoo 19+). Server secrets only.
# Use a dedicated Odoo user with read-only access to planning.slot and
# svs.tech.visit for company 2, never an admin key.
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_API_KEY=
# Hostnames the gateway may call: the Odoo TEST server only. The production Odoo
# (Odoo.sh, *.odoo.sh / *.odoo.com) is always refused.
ODOO_ALLOWED_HOSTS=

# Odoo gateway (docker compose service odoo-gateway). Uses ODOO_BASE_URL,
# ODOO_API_KEY and ODOO_DATABASE above; apps only get a per-project gateway token.
# Copy gateway/projects.example.json to this path and fill in token hashes.
GATEWAY_PROJECTS_FILE=./gateway/projects.json

# DIG Builder agent (agent/). Uses ANTHROPIC_API_KEY above. Optional: give the
# agent the odoo_schema tool through the gateway with a project token.
DIG_GATEWAY_URL=
DIG_GATEWAY_TOKEN=

# DIG Builder sandbox and previews (sandbox/). Generate the hash and secret with
# `bun run preview:password '<wachtwoord>'`. Previews live at <id>.<PREVIEW_DOMAIN>.
PREVIEW_DOMAIN=
PREVIEW_PASSWORD_HASH=
PREVIEW_SESSION_SECRET=
PREVIEW_PROJECTS_FILE=./sandbox/previews.json
PREVIEW_NETWORK=dig-preview
PREVIEW_PORT=8090
# Only for installs behind a TLS-intercepting proxy:
DIG_SANDBOX_CA_BUNDLE=
