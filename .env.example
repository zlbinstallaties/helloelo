# Optional local-development values. Keep every real value outside the repository.
# The HelloLeo preview injects its integration key server-side; do not put a real
# key in this file or in browser code.
HELLOLEO_API_KEY=
DEV_DB_PATH=

# DIG Builder (independent build service; all values are intentionally empty)
BUILDER_ADMIN_TOKEN=
BUILDER_DATA_DIR=/data
BUILDER_RUNNER_URL=http://runner:8090
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PROPOSAL_MAX_OUTPUT_TOKENS=2048

# Direct Odoo client (JSON-2 API, Odoo 19+). When set, the dashboard reads Odoo
# directly instead of through the HelloLeo proxy. Server secrets only.
# Use a dedicated Odoo user with read-only access to planning.slot and
# svs.tech.visit for company 2, never an admin key.
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_API_KEY=
