{
  "name": "dig-monteursdashboard",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node scripts/serve.mjs",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test:app": "node --experimental-strip-types --no-warnings --test-reporter=spec --test test/*.test.ts",
    "test:odoo": "node --experimental-strip-types scripts/test-odoo-client.mjs && node --experimental-strip-types --no-warnings scripts/test-demo-odoo.mjs",
    "test:gateway": "node --experimental-strip-types --test gateway/test/*.test.ts",
    "typecheck:gateway": "tsc -p gateway",
    "gateway:token": "node --experimental-strip-types gateway/src/token.ts",
    "test:agent": "cd agent && bun install --frozen-lockfile && bun run test",
    "typecheck:agent": "cd agent && tsc -p .",
    "test:sandbox": "node --experimental-strip-types --no-warnings --test sandbox/test/*.test.ts",
    "typecheck:sandbox": "tsc -p sandbox",
    "sandbox:run": "node --experimental-strip-types --no-warnings sandbox/src/cli.ts",
    "sandbox:image": "docker build -t dig-sandbox:1 sandbox",
    "preview:start": "node --experimental-strip-types --no-warnings sandbox/src/main.ts",
    "test:builder-app": "node --experimental-strip-types --no-warnings --test builder-app/test/*.test.ts",
    "typecheck:builder-app": "tsc -p builder-app",
    "test:deploy": "node --experimental-strip-types --no-warnings --test deploy/test/*.test.ts",
    "typecheck:deploy": "tsc -p deploy",
    "install:server": "node --experimental-strip-types --no-warnings deploy/install/main.ts",
    "builder:start": "node --experimental-strip-types --no-warnings builder-app/src/main.ts",
    "preview:password": "node --experimental-strip-types --no-warnings sandbox/src/hash-password.ts",
    "local:setup": "node --experimental-strip-types --no-warnings scripts/local-setup.ts",
    "local:gateway": "node --env-file=.local/gateway.env --experimental-strip-types --no-warnings gateway/src/main.ts",
    "local:dashboard": "node --env-file=.local/dashboard.env scripts/serve.mjs",
    "local:demo-odoo": "node scripts/demo-odoo.mjs",
    "local:rehearsal": "node scripts/local-rehearsal.mjs",
    "test:odoo-addon": "python3 odoo_addon/dig_planning_unavailability/stub_tests/test_guard.py"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-aspect-ratio": "1.1.15",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-menubar": "1.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.50",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.42.0",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-resizable-panels": "4.12.4",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "srvx": "0.11.22",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/router-cli": "1.167.34",
    "@tanstack/router-plugin": "1.168.36",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "0.57.0",
    "oxlint": "1.82.0",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
