<odoo>
    <record id="view_dig_builder_project_tree" model="ir.ui.view">
        <field name="name">dig.builder.project.tree</field>
        <field name="model">dig.builder.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="provider"/>
                <field name="model"/>
                <field name="state"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_dig_builder_project_form" model="ir.ui.view">
        <field name="name">dig.builder.project.form</field>
        <field name="model">dig.builder.project</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh_metadata" type="object" string="Refresh metadata" class="btn-secondary"/>
                    <button name="action_generate_proposal" type="object" string="Generate proposal" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve proposal" class="btn-primary" invisible="state != 'proposed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,proposed,approved,built"/>
                    <field name="phase" widget="statusbar" statusbar_visible="connect,describe,build,publish"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="provider"/>
                        <field name="model"/>
                        <field name="company_id"/>
                        <field name="owner_id"/>
                        <field name="service_project_id" readonly="1"/>
                        <field name="phase"/>
                    </group>
                    <group>
                        <field name="proposal" readonly="1"/>
                        <field name="metadata_summary" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dig_builder_project" model="ir.actions.act_window">
        <field name="name">DIG Builder Projects</field>
        <field name="res_model">dig.builder.project</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('dig_builder.group_dig_builder_admin'))]"/>
    </record>

    <menuitem id="menu_dig_builder_root" name="DIG Builder" groups="dig_builder.group_dig_builder_admin"/>
    <menuitem id="menu_dig_builder_projects" name="Projects" parent="menu_dig_builder_root" action="action_dig_builder_project" groups="dig_builder.group_dig_builder_admin"/>
</odoo>
