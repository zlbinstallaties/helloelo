# /etc/dig-builder/stack.env  (docker compose; chmod 600, never commit)
ACME_EMAIL=beheer@example.nl
ODOO_BASE_URL=https://odoo20.srv1938209.hstgr.cloud
# The Odoo TEST server only. Odoo.sh / odoo.com hosts are always refused.
ODOO_ALLOWED_HOSTS=odoo20.srv1938209.hstgr.cloud
ODOO_API_KEY=
ODOO_DATABASE=
GATEWAY_PROJECTS_FILE=/etc/dig-builder/gateway-projects.json

# /etc/dig-builder/preview.env  (systemd; chmod 600) - separate file, same format:
#   PREVIEW_DOMAIN=apps.example.nl
#   PREVIEW_PASSWORD_HASH=...         from: bun run preview:password '<wachtwoord>'
#   PREVIEW_SESSION_SECRET=...        same command
#   PREVIEW_PROJECTS_FILE=/etc/dig-builder/previews.json
#   PREVIEW_NETWORK=dig-preview
#   PREVIEW_RELEASES_DIR=/srv/dig-builder/releases     published versions (<id>-live hostnames); same dir as the builder app

# /etc/dig-builder/builder-app.env  (systemd; chmod 600) - the builder app, same format:
#   BUILDER_APP_PROJECTS_FILE=/etc/dig-builder/builder-projects.json   (see builder-app/projects.example.json)
#   BUILDER_APP_DATA_DIR=/srv/dig-builder/builder-data                 (outside every project checkout)
#   BUILDER_APP_PASSWORD_HASH=...      from: bun run preview:password '<wachtwoord>'
#   BUILDER_APP_SESSION_SECRET=...     same command (PREVIEW_SESSION_SECRET value; use a different one)
#   ANTHROPIC_API_KEY=...              only in this file, never in git
#   DASHBOARD_GATEWAY_TOKEN=...        token named by gatewayTokenEnv in the projects file
#   BUILDER_APP_RELEASES_DIR=/srv/dig-builder/releases   needed when a project has "publish"
#   DASHBOARD_LIVE_GATEWAY_TOKEN=...   the published app's own gateway token (publish.gatewayTokenEnv)
# and in stack.env, the hostname Caddy serves the builder app on (DNS A record to the VPS):
#   BUILDER_DOMAIN=bouwen.example.nl
